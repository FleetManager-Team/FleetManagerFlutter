@startuml FleetManager_Class_Diagram_Services\
title FleetManager \'97 Class diagram (2/2): provider, servizi e persistenza\
\
left to right direction\
scale max 1450 width\
skinparam backgroundColor #FFFFFF\
skinparam shadowing false\
skinparam dpi 180\
skinparam defaultFontName Helvetica\
skinparam defaultFontSize 11\
skinparam ArrowColor #52677A\
skinparam ArrowThickness 1.0\
skinparam linetype ortho\
skinparam nodesep 28\
skinparam ranksep 42\
skinparam packageStyle rectangle\
skinparam class \{\
  BackgroundColor #F8FAFC\
  BorderColor #52677A\
  FontColor #1F2933\
  HeaderBackgroundColor #DCEAF7\
  AttributeIconSize 0\
\}\
\
package "Coordinamento applicativo" #EEF7EE \{\
  class FleetProvider <<ChangeNotifier>> \{\
    -utenteLoggato: Utente?\
    -isLoading: bool\
    +veicoli: List<Veicolo>\
    +prenotazioni: List<Prenotazione>\
    +manutenzioni: List<Manutenzione>\
    +utenti: List<Utente>\
    +notifiche: List<Notifica>\
    +restituzioni: List<Restituzione>\
    +checkups: List<CheckupVeicolo>\
    +scadenze: List<Scadenza>\
    --\
    +inizializzaDati(): Future<void>\
    +login(...): Future<bool>\
    +crea/conferma/annullaPrenotazione(...)\
    +completaRestituzioneConNotifiche(...)\
    +programma/chiudiManutenzione(...)\
    +aggiungi/eliminaUtente(...)\
    +aggiungi/eliminaVeicolo(...)\
    +crea/modifica/chiudiScadenza(...)\
    +isVeicoloDisponibile(...): bool\
  \}\
\
  class ImpostazioniProvider <<ChangeNotifier>> \{\
    +checkupObbligatorio: bool\
    +approvazioneRichiesta: bool\
    +moduloPedaggiAbilitato: bool\
    +fotoScontrinoObbligatoria: bool\
    +fotoDanniObbligatoria: bool\
    +fotoPedaggiObbligatoria: bool\
    --\
    +ensureLoaded(): Future<void>\
    +set...(value): Future<void>\
  \}\
\}\
\
package "Servizi di dominio" #FFF8EC \{\
  class AuthService <<service>> \{\
    +login(...): Future<Utente?>\
    +getTuttiUtenti(): Future<List<Utente>>\
    +create/update/eliminaUtente(...)\
  \}\
  class VeicoloService <<service>> \{\
    +fetchAllVeicoli(): Future<List<Veicolo>>\
    +getVeicoloByTarga(...): Future<Veicolo?>\
    +createVeicolo(...): Future<void>\
    +updateStatoVeicolo(...): Future<void>\
  \}\
  class PrenotazioneService <<service>> \{\
    +fetchPrenotazioni(): Future<List<Prenotazione>>\
    +creaPrenotazione(...): Future<void>\
    +conferma/annulla/completa(...)\
    +validaDisponibilita(...): Future<bool>\
  \}\
  class ManutenzioneService <<service>> \{\
    +fetchTutte(): Future<List<Manutenzione>>\
    +registra/chiudiIntervento(...)\
    +segnalareInterventoStraordinario(...)\
    +updateManutenzione(...)\
  \}\
  class ScadenzaService <<service>> \{\
    +fetchTutteLeScadenze(): Future<List<Scadenza>>\
    +crea/modifica/eliminaScadenza(...)\
    +chiudiScadenza(...)\
  \}\
  class NotificaService <<service>> \{\
    +fetchMieNotifiche(...): Future<List<Notifica>>\
    +segnaLetta(...): Future<void>\
    +notificaPrenotazione/Checkup/Restituzione(...)\
    +elimina/svuotaNotifiche(...)\
  \}\
\}\
\
package "Servizi usati direttamente dalla UI" #EDF6FF \{\
  class CheckupService <<service>> \{\
    +inviaCheckupCompleto(...): Future<void>\
    +getStoricoCheckup(...): Future<List<Map>>\
  \}\
  class RestituzioneService <<service>> \{\
    +completaRestituzione(...): Future<void>\
  \}\
\}\
\
package "Persistenza locale / remota" #F3F4F6 \{\
  class ImpostazioniService <<service>> \{\
    +get...(key): Future<bool>\
    +set...(key, value): Future<void>\
  \}\
  interface SupabaseClient <<external>>\
  interface SharedPreferences <<external>>\
\}\
\
FleetProvider *-- AuthService\
FleetProvider *-- VeicoloService\
FleetProvider *-- PrenotazioneService\
FleetProvider *-- ManutenzioneService\
FleetProvider *-- ScadenzaService\
FleetProvider *-- NotificaService\
ImpostazioniProvider *-- ImpostazioniService\
\
AuthService ..> SupabaseClient\
VeicoloService ..> SupabaseClient\
PrenotazioneService ..> SupabaseClient\
ManutenzioneService ..> SupabaseClient\
ScadenzaService ..> SupabaseClient\
NotificaService ..> SupabaseClient\
CheckupService ..> SupabaseClient\
RestituzioneService ..> SupabaseClient\
ImpostazioniService ..> SharedPreferences\
\
' Griglie invisibili compatte\
AuthService -[hidden]down- ManutenzioneService\
VeicoloService -[hidden]down- ScadenzaService\
PrenotazioneService -[hidden]down- NotificaService\
AuthService -[hidden]right- VeicoloService\
VeicoloService -[hidden]right- PrenotazioneService\
CheckupService -[hidden]right- RestituzioneService\
\
legend bottom\
  |= Simbolo |= Significato |\
  | *-- | Servizio posseduto/iniettato dal provider |\
  | ..> | Dipendenza tecnologica |\
endlegend\
@enduml}