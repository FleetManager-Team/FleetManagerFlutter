package "Modello di dominio" #F7FAFC \{\
  class Utente <<entity>> \{\
    +idUtente: int\
    +nome: String\
    +cognome: String\
    +email: String\
    +password: String?\
    +ruoloUtente: RuoloUtente\
    +patente: String?\
  \}\
\
  class Prenotazione <<entity>> \{\
    +idPrenotazione: int\
    +dataInizio: DateTime\
    +dataFine: DateTime\
    +stato: StatoPrenotazione\
    +tipo: TipoPrenotazione\
    +idUtente: int\
    +targa: String\
  \}\
\
  class Veicolo <<entity>> \{\
    +targa: String\
    +tipo: TipoVeicolo\
    +marca: String\
    +modello: String\
    +annoImmatricolazione: int\
    +stato: StatoVeicolo\
    +km: int\
  \}\
\
  class CheckupVeicolo <<entity>> \{\
    +id: String?\
    +idPrenotazione: int\
    +targa: String\
    +driverId: String\
    +dataCheck: DateTime\
    +urlFotoFronte: String\
    +urlFotoRetro: String\
    +urlFotoDx: String\
    +urlFotoSx: String\
    +luciOk: bool\
    +gommeOk: bool\
    +interniOk: bool\
    +noteDanni: String?\
    +urlFirma: String?\
  \}\
\
  class Restituzione <<entity>> \{\
    +idRestituzione: int?\
    +idPrenotazione: int\
    +kmFinali: int\
    +dataRestituzione: DateTime\
    +rifornimentoEffettuato: bool\
    +litriCarburante: double?\
    +importoEuro: double?\
    +urlScontrino: String?\
    +haPedaggi: bool\
    +importoPedaggi: double?\
    +urlFotoPedaggio: String?\
    +danniPresenti: bool\
    +descrizioneDanni: String?\
    +urlFotoDanni: String?\
    +isEmergenza: bool\
    +noteEmergenza: String?\
    +posizioneEmergenza: String?\
  \}\
\
  class Manutenzione <<entity>> \{\
    +idManutenzione: int\
    +data: DateTime\
    +oraFine: DateTime?\
    +tipo: TipoManutenzione\
    +descrizione: String\
    +targa: String\
    +luogo: String\
  \}\
\
  class Scadenza <<entity>> \{\
    +idScadenza: int\
    +tipo: TipoScadenza\
    +data: DateTime\
    +notificata: bool\
    +targa: String\
    +kmScadenza: int?\
    +mesiScadenza: int?\
    +chiusa: bool\
    +dataChiusura: DateTime?\
    +costoChiusura: double?\
    +dettagliChiusura: String?\
    +descrizione: String?\
  \}\
\
  class Notifica <<entity>> \{\
    +idNotifica: int?\
    +tipo: TipoNotifica\
    +messaggio: String\
    +dataInvio: DateTime\
    +letta: bool\
    +idUtente: int\
    +idScadenza: int?\
  \}\
\
  class SpesaDriver <<value object>> \{\
    +idUtente: int\
    +carburante: double\
    +pedaggi: double\
    +totale: double\
  \}\
\
  enum "Enumerazioni" as Enums \{\
    RuoloUtente = driver | manager\
    TipoVeicolo = auto | furgone | moto\
    StatoVeicolo = disponibile | inManutenzione | prenotato | fuoriServizio\
    TipoPrenotazione = utente | aziendale | privata\
    StatoPrenotazione = richiesta | confermata | attesaCheckup | attiva | completata | annullata | sospesa\
    TipoManutenzione = ordinaria | straordinaria | riparazione\
    TipoScadenza = assicurazione | bollo | revisione | tagliando\
    TipoNotifica = info | alert | scadenza | manutenzione\
  \}\
\}\
\
Utente "1" -- "0..*" Prenotazione : effettua >\
Veicolo "1" -- "0..*" Prenotazione : assegnato a >\
Prenotazione "1" *-- "0..1" CheckupVeicolo : check-up\
Prenotazione "1" *-- "0..1" Restituzione : chiusura\
Veicolo "1" -- "0.." Manutenzione : interventi\
Veicolo "1" -- "0.." Scadenza : scadenze\
Utente "1" -- "0..*" Notifica : riceve >\
Scadenza "0..1" -- "0..*" Notifica : genera >\
Utente "1" -- "0..1" SpesaDriver : riepilogo >\
\
Utente ..> Enums : usa\
Prenotazione ..> Enums\
Veicolo ..> Enums\
Manutenzione ..> Enums\
Scadenza ..> Enums\
Notifica ..> Enums\
\
' Vincoli invisibili per una griglia A4 orizzontale stabile\
Utente -[hidden]right- Prenotazione\
Prenotazione -[hidden]right- Veicolo\
CheckupVeicolo -[hidden]right- Restituzione\
Manutenzione -[hidden]right- Scadenza\
\
legend bottom\
  |= Simbolo |= Significato |\
  | *-- | Composizione |\
  | --  | Associazione con cardinalit\'e0 |\
  | ..> | Utilizzo di un tipo enumerativo |\
endlegend\
@enduml\
