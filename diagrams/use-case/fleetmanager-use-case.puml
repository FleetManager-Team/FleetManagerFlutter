@startuml
title FleetManager — Use Case Diagram

' Impaginazione verticale adatta a una pagina di tesi.
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 42
skinparam ArrowColor #53657A
skinparam ActorBorderColor #334155
skinparam ActorFontColor #1F2937
skinparam RectangleBorderColor #334155
skinparam usecase {
  BackgroundColor #F7FAFC
  BorderColor #2F5597
  FontColor #1F2937
}

rectangle "Sistema FleetManager" as SYSTEM {
  usecase "UC-01\nEffettuare login" as UC01

  package "Casi d'uso del Driver" as DRIVER_AREA {
    usecase "UC-02\nVisualizzare veicoli\ndisponibili" as UC02
    usecase "UC-03\nRichiedere\nprenotazione" as UC03
    usecase "UC-04\nAnnullare propria\nprenotazione" as UC04
    usecase "UC-05\nEseguire check-up\niniziale" as UC05
    usecase "UC-06\nRestituire\nveicolo" as UC06
    usecase "UC-07\nSegnalare\nemergenza" as UC07
    usecase "UC-08\nConsultare notifiche\npersonali" as UC08
    usecase "UC-09\nVisualizzare costi\npersonali" as UC09

    ' Quattro righe da due elementi: sviluppo stretto e verticale.
    UC02 -[hidden]right- UC03
    UC04 -[hidden]right- UC05
    UC06 -[hidden]right- UC07
    UC08 -[hidden]right- UC09
    UC02 -[hidden]down- UC04
    UC04 -[hidden]down- UC06
    UC06 -[hidden]down- UC08
    UC03 -[hidden]down- UC05
    UC05 -[hidden]down- UC07
    UC07 -[hidden]down- UC09
  }

  package "Casi d'uso del Manager" as MANAGER_AREA {
    usecase "UC-10\nGestire utenti\n(CRUD)" as UC10
    usecase "UC-11\nGestire veicoli\n(CRUD)" as UC11
    usecase "UC-12\nApprovare/Rifiutare\nprenotazioni" as UC12
    usecase "UC-13\nPianificare\nmanutenzione" as UC13
    usecase "UC-14\nChiudere intervento\ndi manutenzione" as UC14
    usecase "UC-15\nGestire scadenze\ntecniche" as UC15
    usecase "UC-16\nMonitorare emergenze\nin corso" as UC16
    usecase "UC-17\nVisualizzare dashboard\ncosti" as UC17
    usecase "UC-18\nModificare stato\nveicolo" as UC18

    UC10 -[hidden]right- UC11
    UC12 -[hidden]right- UC13
    UC14 -[hidden]right- UC15
    UC16 -[hidden]right- UC17
    UC10 -[hidden]down- UC12
    UC12 -[hidden]down- UC14
    UC14 -[hidden]down- UC16
    UC16 -[hidden]down- UC18
    UC11 -[hidden]down- UC13
    UC13 -[hidden]down- UC15
    UC15 -[hidden]down- UC17
  }

  package "Servizi applicativi condivisi" as SHARED_AREA {
    usecase "Annullare prenotazioni\nin conflitto" as CONFLICT
    usecase "Inviare\nnotifiche" as NOTIFY
    usecase "Verificare scadenze\nimminenti" as CHECK
    usecase "Accedere a persistenza,\nautenticazione e storage" as BACKEND

    CONFLICT -[hidden]right- NOTIFY
    CHECK -[hidden]right- BACKEND
    CONFLICT -[hidden]down- CHECK
    NOTIFY -[hidden]down- BACKEND
  }

  ' Ordine verticale delle quattro sezioni principali.
  UC01 -[hidden]down- DRIVER_AREA
  DRIVER_AREA -[hidden]down- MANAGER_AREA
  MANAGER_AREA -[hidden]down- SHARED_AREA
}

actor Driver
actor Manager
actor "Backend Supabase" as Supabase

' Gli attori sono affiancati solo alla propria area.
Driver -right- UC01
Driver -right- UC02
Driver -right- UC03
Driver -right- UC04
Driver -right- UC05
Driver -right- UC06
Driver -right- UC07
Driver -right- UC08
Driver -right- UC09

UC01 -right- Manager
UC10 -right- Manager
UC11 -right- Manager
UC12 -right- Manager
UC13 -right- Manager
UC14 -right- Manager
UC15 -right- Manager
UC16 -right- Manager
UC17 -right- Manager
UC18 -right- Manager

' Relazioni include/extend indicate nella tesi.
UC03 .left.> UC02 : <<include>>
UC12 .up.> UC03 : <<extend>>
UC12 .down.> CONFLICT : <<include>>
UC12 .down.> NOTIFY : <<include>>
UC12 .up.> UC05 : <<extend>>\n[prenotazione confermata]
UC15 .down.> CHECK : <<include>>
CHECK .up.> NOTIFY : <<include>>

BACKEND -down- Supabase

note right of Supabase
  Persistenza, autenticazione
  e storage dei file
end note
@enduml
